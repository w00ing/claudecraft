{
  "name": "@wyverselabs/claudecraft",
  "version": "0.1.12",
  "description": "CLI for installing StarCraft sounds into Claude Code hooks",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "bin": {
    "claudecraft": "./dist/cli.js"
  },
  "files": [
    "dist",
    "curated-sounds",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:cli && bun run build:game-ui",
    "build:cli": "tsc -p tsconfig.json",
    "build:game-ui": "vite build",
    "typecheck": "bun run typecheck:cli && bun run typecheck:game-ui",
    "typecheck:cli": "tsc --noEmit -p tsconfig.json",
    "typecheck:game-ui": "tsc --noEmit -p game-ui/tsconfig.json",
    "test": "bun test",
    "dev:game": "concurrently -k -n UI,CLI \"vite build --watch\" \"bun --watch src/cli.ts game --ui phaser --port 4318 --open\"",
    "dev:game-ui": "vite",
    "curate:tool-sounds": "bun scripts/curate-tool-pools.ts --write",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "starcraft",
    "cli"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "@clack/prompts": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "phaser": "^3.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
